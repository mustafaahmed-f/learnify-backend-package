{
  "name": "@mustafahmed1997/learnify-backend",
  "version": "1.0.0",
  "description": "Shared Clerk-based auth middlewares, role checking, error utilities, and Express types for Learnify backend microservices.",
  "keywords": [
    "express",
    "clerk",
    "middleware",
    "learnify"
  ],
  "license": "ISC",
  "author": "Mostafa Ahmed",
  "type": "module",
  "main": "./dist/index.js",
