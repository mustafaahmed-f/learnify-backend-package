    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@clerk/express": "^1.7.74",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@clerk/express": "^1.7.74",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.39",
    "express": "^5.1.0",
    "typescript": "^5.1.6",
    "vitest": "^3.0.0"
  }
}
